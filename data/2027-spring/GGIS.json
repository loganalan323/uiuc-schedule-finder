r NDEG:GIS & Data Sci ONL -UIUC."],"note":""}]},{"id":"GGIS 478","title":"Techniques of Remote Sensing","creditHours":"3 hours.","sections":[{"crn":"75633","code":"A","type":"Laboratory-Discussion","partOfTerm":"1","meetings":[{"type":"Laboratory-Discussion","days":["T","R"],"start":570,"end":650,"location":"338 Davenport Hall","instructors":["Umar, U"]}],"restrictions":[],"note":""}]},{"id":"GGIS 480","title":"Principles of Geographic Information Science","creditHours":"4 hours.","sections":[{"crn":"74202","code":"MS","type":"Online","partOfTerm":"A","meetings":[{"type":"Online","days":[],"start":null,"end":null,"location":"","instructors":["Umar, U"]}],"restrictions":["Restricted to NDEG:WeatherClimteRA ONL-UIUC, MS:WeatherClimteRA ONL-UIUC, MS:Environ Geology ONL-UIUC, NDEG:Environ Geology ONL-UIUC, MS:GIS & Data Sci ONL - UIUC, or NDEG:GIS & Data Sci ONL -UIUC."],"note":""},{"crn":"74191","code":"ONL","type":"Online","partOfTerm":"A","meetings":[{"type":"Online","days":[],"start":null,"end":null,"location":"","instructors":["Umar, U"]}],"restrictions":["Restricted to Graduate - Urbana-Champaign.","Not intended for NDEG:WeatherClimteRA ONL-UIUC, MS:WeatherClimteRA ONL-UIUC, MS:Environ Geology ONL-UIUC, NDEG:Environ Geology ONL-UIUC, MS:GIS & Data Sci ONL - UIUC, or NDEG:GIS & Data Sci ONL -UIUC."],"note":"Basic GIS and Python skills are required. <br/>Undergraduates: Please contact <a href=\"mailto:umar83@illinois.edu\">umar83@illinois.edu</a> to request enrollment in this course."}]},{"id":"GGIS 482","title":"Challenges of Sustainability","creditHours":"3 hours.","sections":[{"crn":"79051","code":"A","type":"Lecture","partOfTerm":"A","meetings":[{"type":"Lecture","days":["T"],"start":660,"end":740,"location":"322 David Kinley Hall","instructors":["Brown, C"]},{"type":"Online","days":["R"],"start":660,"end":740,"location":"","instructors":["Brown, C"]}],"restrictions":[],"note":"Thursday class will meet virtually."}]},{"id":"GGIS 491","title":"Research in Geography","creditHours":"2 hours.","sections":[{"crn":"74194","code":"A","type":"Lecture-Discussion","partOfTerm":"1","meetings":[{"type":"Lecture-Discussion","days":["T"],"start":840,"end":950,"location":"2084 Natural History Building","instructors":["Zaragocin, S"]}],"restrictions":[],"note":""}]},{"id":"GGIS 495","title":"Advanced Topics in Geography","creditHours":"3 OR 4 hours.","sections":[{"crn":"75452","code":"JW","type":"Lecture-Discussion","partOfTerm":"1","meetings":[{"type":"Lecture-Discussion","days":["M"],"start":570,"end":710,"location":"Location Pending","instructors":["Wang, J"]}],"restrictions":["Restricted to Graduate - Urbana-Champaign."],"note":"Water is one of the most dynamic and essential physical components on Earth. Understanding its abundance, quality, distribution, and variability remains a priority for both scientific research and societal needs. The rapid advancement of remote sensing, techniques for acquiring information without direct physical contact, has enabled both historical and real-time measurement of various hydrological parameters with unprecedented accuracy and spatial resolution. This advanced, 3-credit-hour course is designed to: (1) enhance students' knowledge of remote sensing and its applications in water resource studies, (2) introduce the latest advancements and trends in hydrological remote sensing, (3) develop students' scientific insight and practical problem-solving skills in water resource studies, and (4) support students' research in water resources and related fields. Topics covered in the course include: (1) reviews of fundamental surface hydrology and hydraulics, (2) key remote sensing techniques, including optical, radar, LiDAR, gravimetric, and sonar methods, and (3) measurement of diverse hydrological parameters, such as water area, level, gradient, depth, bathymetry, mass, and discharge, and (4) integrated approaches to water resource studies."},{"crn":"74195","code":"JW2","type":"Lecture-Discussion","partOfTerm":"1","meetings":[{"type":"Lecture-Discussion","days":["M"],"start":570,"end":710,"location":"Location Pending","instructors":["Wang, J"]}],"restrictions":["Restricted to Undergrad - Urbana-Champaign."],"note":""}]},{"id":"GGIS 517","title":"Geospatial Visualization & Analytics","creditHours":"4 hours.","sections":[{"crn":"74204","code":"MS","type":"Online","partOfTerm":"A","meetings":[{"type":"Online","days":[],"start":null,"end":null,"location":"","instructors":["Portelli, R"]}],"restrictions":["Restricted to Graduate - Urbana-Champaign.","Restricted to NDEG:WeatherClimteRA ONL-UIUC, MS:WeatherClimteRA ONL-UIUC, MS:Environ Geology ONL-UIUC, NDEG:Environ Geology ONL-UIUC, MS:GIS & Data Sci ONL - UIUC, or NDEG:GIS & Data Sci ONL -UIUC."],"note":""},{"crn":"74197","code":"ONL","type":"Online","partOfTerm":"A","meetings":[{"type":"Online","days":[],"start":null,"end":null,"location":"","instructors":["Portelli, R"]}],"restrictions":["Not intended for MS:WeatherClimteRA ONL-UIUC, NDEG:WeatherClimteRA ONL-UIUC, MS:Environ Geology ONL-UIUC, NDEG:Environ Geology ONL-UIUC, MS:GIS & Data Sci ONL - UIUC, or NDEG:GIS & Data Sci ONL -UIUC."],"note":""}]},{"id":"GGIS 590","title":"Graduate Independent Study","creditHours":"1 TO 8 hours.","sections":[{"crn":"74403","code":"","type":"Independent Study","partOfTerm":"1","meetings":[{"type":"Independent Study","days":[],"start":null,"end":null,"location":"Location Pending","instructors":[]}],"restrictions":[],"note":"This CRN is not valid for registration. Please complete this webform to get your faculty advisor's unique CRN: https://go.illinois.edu/GGIS-590"}]},{"id":"GGIS 593","title":"Geography & GIS Colloquium","creditHours":"0 hours.","sections":[{"crn":"74200","code":"FRI","type":"Seminar","partOfTerm":"1","meetings":[{"type":"Seminar","days":["F"],"start":900,"end":960,"location":"2049 Natural History Building","instructors":["Zaragocin, S"]}],"restrictions":[],"note":""}]},{"id":"GGIS 595","title":"Graduate Seminar","creditHours":"1 TO 4 hours.","sections":[{"crn":"78868","code":"MS","type":"Online","partOfTerm":"B","meetings":[{"type":"Online","days":[],"start":null,"end":null,"location":"","instructors":["Lin, Y"]}],"restrictions":["Restricted to NDEG:WeatherClimteRA ONL-UIUC, MS:WeatherClimteRA ONL-UIUC, MS:Environ Geology ONL-UIUC, NDEG:Environ Geology ONL-UIUC, MS:GIS & Data Sci ONL - UIUC, or NDEG:GIS & Data Sci ONL -UIUC."],"note":"This course introduces advanced theories and practices for developing and evaluating geospatial artificial intelligence (AI) methods. Students will learn geospatial AI for representing complex spatial information, modeling spatiotemporal dynamics, and reasoning across text and imagery. Key topics include spatial representation learning, spatiotemporal AI, explainability, fairness, and foundation models. Students will develop the skills needed to implement geospatial AI systems and interpret their results in applied contexts."},{"crn":"78867","code":"ONL","type":"Online","partOfTerm":"B","meetings":[{"type":"Online","days":[],"start":null,"end":null,"location":"","instructors":["Lin, Y"]}],"restrictions":["Not intended for NDEG:WeatherClimteRA ONL-UIUC, MS:WeatherClimteRA ONL-UIUC, MS:Environ Geology ONL-UIUC, NDEG:Environ Geology ONL-UIUC, MS:GIS & Data Sci ONL - UIUC, or NDEG:GIS & Data Sci ONL -UIUC."],"note":"This course introduces advanced theories and practices for developing and evaluating geospatial artificial intelligence (AI) methods. Students will learn geospatial AI for representing complex spatial information, modeling spatiotemporal dynamics, and reasoning across text and imagery. Key topics include spatial representation learning, spatiotemporal AI, explainability, fairness, and foundation models. Students will develop the skills needed to implement geospatial AI systems and interpret their results in applied contexts."}]},{"id":"GGIS 598","title":"Graduate Capstone Project","creditHours":"4 hours.","sections":[{"crn":"74405","code":"