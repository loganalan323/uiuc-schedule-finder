ctions":[{"crn":"53540","code":"AC","type":"Lecture-Discussion","partOfTerm":"1","meetings":[{"type":"Lecture-Discussion","days":["T"],"start":750,"end":830,"location":"210A Education Building","instructors":["Bosch, N"]}],"restrictions":["Restricted to Graduate - Urbana-Champaign."],"note":""},{"crn":"34335","code":"AO","type":"Lecture-Discussion","partOfTerm":"1","meetings":[{"type":"Lecture-Discussion","days":["R"],"start":720,"end":770,"location":"210A Education Building","instructors":["Gladstone, J"]}],"restrictions":["Restricted to Graduate - Urbana-Champaign."],"note":""},{"crn":"62202","code":"AP","type":"Lecture-Discussion","partOfTerm":"1","meetings":[{"type":"Lecture-Discussion","days":["W"],"start":540,"end":710,"location":"210A Education Building","instructors":["Khuri, M"]}],"restrictions":["Restricted to Graduate - Urbana-Champaign."],"note":"Advanced Practicum in Supervision. This section is restricted to students in Counseling Psychology."},{"crn":"56388","code":"BBB","type":"Online","partOfTerm":"1","meetings":[{"type":"Online","days":[],"start":null,"end":null,"location":"","instructors":["Chavez, D"]}],"restrictions":["Restricted to Graduate - Urbana-Champaign."],"note":"Course explores human brain structure and function as they pertain to behavior. It covers topics such as functional neuroanatomy including organization of the nervous system, electrical and chemical conduction, hormones, sensation, pain, sexual activity, memory, addiction, emotion, mental disorders and treatment modalities for mental disorders in view of brain structure and function. Day1Access course materials cost $54.89. For more information see https://go.illinois.edu/Day1Access."},{"crn":"34339","code":"BH","type":"Lecture-Discussion","partOfTerm":"1","meetings":[{"type":"Lecture-Discussion","days":["W"],"start":720,"end":770,"location":"210A Education Building","instructors":["Lewis, J"]}],"restrictions":["Restricted to Graduate - Urbana-Champaign."],"note":""},{"crn":"34341","code":"BM","type":"Lecture-Discussion","partOfTerm":"1","meetings":[{"type":"Lecture-Discussion","days":["M"],"start":720,"end":770,"location":"242 Education Building","instructors":["Goodnight, M","Kern, J"]}],"restrictions":["Restricted to Graduate - Urbana-Champaign."],"note":""},{"crn":"34359","code":"DAC","type":"Lecture-Discussion","partOfTerm":"1","meetings":[{"type":"Lecture-Discussion","days":["F"],"start":540,"end":710,"location":"166 Education Building","instructors":["Kern, J"]}],"restrictions":["Restricted to Graduate - Urbana-Champaign."],"note":"Seminar Full Title: Introduction to R for Data Analysis and Computation"},{"crn":"34356","code":"E","type":"Practice","partOfTerm":"1","meetings":[{"type":"Practice","days":[],"start":null,"end":null,"location":"Location Pending","instructors":["Khuri, M"]}],"restrictions":["Restricted to Graduate - Urbana-Champaign."],"note":""},{"crn":"62200","code":"LBT","type":"Lecture-Discussion","partOfTerm":"1","meetings":[{"type":"Lecture-Discussion","days":["F"],"start":780,"end":950,"location":"376 Education Building","instructors":["Chen, L"]}],"restrictions":["Restricted to Graduate - Urbana-Champaign."],"note":"Title: Language, Brain, and Technology. This cross-disciplinary course explores how cognitive, neural, and computational approaches inform our understanding of language processing, and how emerging technologies can support language learning and education. Topics include the cognitive and neural mechanisms underlying language comprehension and reading; the influence of specific languages and writing systems on these processes; language processing across diverse populations; neural research methods used in language studies; applications of generative AI and large language models in modeling human language processes; and the use of AI and immersive technologies to enhance language learning. Students will gain an integrated understanding of how psychology, neuroscience, and artificial intelligence intersect to advance both research and educational practices in language. This course will meet with LING 591 LBT and PSYC 593 LBT."},{"crn":"62820","code":"QWR","type":"Online","partOfTerm":"1","meetings":[{"type":"Online","days":["W"],"start":720,"end":1010,"location":"","instructors":["Goodnight, M"]}],"restrictions":[],"note":"Meets with CI 552 A."},{"crn":"40618","code":"SPA","type":"Lecture-Discussion","partOfTerm":"1","meetings":[{"type":"Lecture-Discussion","days":["W"],"start":840,"end":1010,"location":"385 Education Building","instructors":[]}],"restrictions":["Restricted to Graduate - Urbana-Champaign.","Restricted to MS:MentalHealthCounseling-UIUC."],"note":"Title: Survey of Psychological Assessment Methods. This course will meet in DRES Conference Room (107)."},{"crn":"34336","code":"TH","type":"Lecture-Discussion","partOfTerm":"1","meetings":[{"type":"Lecture-Discussion","days":["R"],"start":750,"end":920,"location":"108 David Kinley Hall","instructors":["Beard, J"]}],"restrictions":["Restricted to Graduate - Urbana-Champaign."],"note":"This course is designed to prepare you to work with individuals attempting to recover from addictions. It will cover a broad range of topics, including foundational information related to addiction and the substances and processes that underlie it, models of assessment, theoretical approaches to treatment, and current professional issues."}]},{"id":"EPSY 591","title":"Field Study and Thesis Seminar","creditHours":"4 TO 8 hours.","sections":[{"crn":"10380","code":"","type":"Independent Study","partOfTerm":"1","meetings":[{"type":"Independent Study","days":[],"start":null,"end":null,"location":"Location Pending","instructors":[]}],"restrictions":[],"note":""}]},{"id":"EPSY 595","title":"Independent Study","creditHours":"0 TO 4 hours.","sections":[{"crn":"10050","code":"","type":"Independent Study","partOfTerm":"1","meetings":[{"type":"Independent Study","days":[],"start":null,"end":null,"location":"Location Pending","instructors"