ctions":[],"note":""}]},{"id":"ESE 379","title":"Introduction to Geographic Information Systems","creditHours":"4 hours.","sections":[{"crn":"54798","code":"AE1","type":"Lecture","partOfTerm":"1","meetings":[{"type":"Lecture","days":["W"],"start":840,"end":950,"location":"1090 Lincoln Hall","instructors":["Minn, M"]}],"restrictions":[],"note":""},{"crn":"62098","code":"ONL","type":"Online","partOfTerm":"A","meetings":[{"type":"Online","days":[],"start":null,"end":null,"location":"","instructors":["Minn, M"]}],"restrictions":["Restricted to BSLAS: ESES Online - UIUC."],"note":""}]},{"id":"ESE 380","title":"Geographic Information Systems II","creditHours":"4 hours.","sections":[{"crn":"61528","code":"A","type":"Laboratory-Discussion","partOfTerm":"1","meetings":[{"type":"Laboratory-Discussion","days":["T","R"],"start":840,"end":920,"location":"1020 Natural History Building","instructors":["Minn, M"]}],"restrictions":[],"note":""}]},{"id":"ESE 389","title":"Environment and Sustainability Field Expedition","creditHours":"3 hours.","sections":[{"crn":"62068","code":"A","type":"Discussion/Recitation","partOfTerm":"1","meetings":[{"type":"Discussion/Recitation","days":["W"],"start":960,"end":1040,"location":"2020A Natural History Building","instructors":["Meghani, N"]}],"restrictions":[],"note":"3 hours. Field expedition to Costa Rica over spring break (approx. 9 days), and weekly seminar. This course uses Costa Rica as a case study to examine issues of sustainability and the environment. Topics include rainforest ecology, land-use issues, sustainable agriculture, global versus local economies, and geologic features of the landscape, including volcanoes and rivers. Estimated program fee of $4,500; scholarships from college and dept. available. Primarily for ESES majors and Unit One Living Learning Community Students but others are encouraged to apply in case spots remain available. Enrollment is through LAS Abroad. Apply at: <a href=\"https://app.studyabroad.illinois.edu/index.cfm?FuseAction=Programs.ViewProgramAngular&id=11881\">ESE 389 Application</a> Applications submitted prior to October 16 will be given priority."}]},{"id":"ESE 401","title":"ESE Capstone","creditHours":"3 hours.","sections":[{"crn":"54841","code":"","type":"Independent Study","partOfTerm":"1","meetings":[{"type":"Independent Study","days":[],"start":null,"end":null,"location":"Location Pending","instructors":[]}],"restrictions":[],"note":""},{"crn":"75713","code":"A","type":"Lecture-Discussion","partOfTerm":"1","meetings":[{"type":"Lecture-Discussion","days":["T","R"],"start":570,"end":650,"location":"222 David Kinley Hall","instructors":["Brown, C"]}],"restrictions":["Restricted to students with Junior or Senior class standing."],"note":""}]},{"id":"ESE 421","title":"Earth Systems Modeling","creditHours":"4 hours.","sections":[{"crn":"74432","code":"B","type":"Lecture-Discussion","partOfTerm":"1","meetings":[{"type":"Lecture-Discussion","days":["M","W","F"],"start":600,"end":650,"location":"1020 Natural History Building","instructors":["Anders, A"]}],"restrictions":[],"note":""}]},{"id":"ESE 445","title":"Earth Resources Sustainability","creditHours":"3 hours.","sections":[{"crn":"61711","code":"A","type":"Online","partOfTerm":"B","meetings":[{"type":"Online","days":[],"start":null,"end":null,"location":"","instructors":["Cole, T"]}],"restrictions":[],"note":"ESE and iSEE minors are welcome to enroll. Please send your UIN to tomkin@illinois.edu to request an override."}]},{"id":"ESE 465","title":"Transportation &Sustainability","creditHours":"3 OR 4 hours.","sections":[{"crn":"65614","code":"G1","type":"Lecture-Discussion","partOfTerm":"1","meetings":[{"type":"Lecture-Discussion","days":["M","W","F"],"start":540,"end":590,"location":"2020A Natural History Building","instructors":["Cidell, J"]}],"restrictions":[],"note":""},{"crn":"65575","code":"U1","type":"Lecture-Discussion","partOfTerm":"1","meetings":[{"type":"Lecture-Discussion","days":["M","W","F"],"start":540,"end":590,"location":"2020A Natural History Building","instructors":["Cidell, J"]}],"restrictions":["Restricted to Undergrad - Urbana-Champaign.","Restricted to BSLAS: Earth,Soc,Env Sust-UIUC."],"note":""}]},{"id":"ESE 467","title":"Multimedia Environmental Communications","creditHours":"3 OR 4 hours.","sections":[{"crn":"70523","code":"A","type":"Lecture-Discussion","partOfTerm":"1","meetings":[{"type":"Lecture-Discussion","days":["T","R"],"start":560,"end":650,"location":"315 Gregory Hall","instructors":["Becker, L"]}],"restrictions":[],"note":""}]},{"id":"ESE 482","title":"Challenges of Sustainability","creditHours":"3 hours.","sections":[{"crn":"63386","code":"A","type":"Lecture","partOfTerm":"A","meetings":[{"type":"Lecture","days":["T"],"start":660,"end":740,"location":"322 David Kinley Hall","instructors":["Brown, C"]},{"type":"Online","days":["R"],"start":660,"end":740,"location":"","instructors":["Brown, C"]}],"restrictions":[],"note":"Thursday class will be virtual."},{"crn":"61598","code":"B","type":"Online","partOfTerm":"A","meetings":[{"type":"Online","days":["R"],"start":660,"end":740,"location":"","instructors":["Brown, C"]},{"type":"Online","days":[],"start":null,"end":null,"location":"","instructors":["Brown, C"]}],"restrictions":["Restricted to BSLAS: ESES Online - UIUC or BSLAS:Environ SustainONL-UIUC."],"note":""}]},{"id":"ESE 486","title":"Environmental Consulting","creditHours":"3 hours.","sections":[{"crn":"79005","code":"A","type":"Online","partOfTerm":"1","meetings":[{"type":"Online","days":[],"start":null,"end":null,"location":"","instructors":["Pettijohn, C"]}],"restrictions":["Restricted to BSLAS: Earth,Soc,Env Sust-UIUC, BSLAS: ESES Online - UIUC, BSLAS: Environ Sustain - UIUC, or BSLAS:Environ SustainONL-UIUC."],"note":""},{"crn":"79006","code":"B","type":"Online","partOfTerm":"1","meetings":[{"type":"Online","days":[],"start":null,"end":null,"location":"","instructors":["Pettijohn, C"]}],"restrictions":["Restricted to NDEG:Graduate OR - UIUC."],"note":"Restricted to Environmental Sustainability graduate certificate students."}]},{"id":"ESE 497","title":"Special Topics in ESE","creditHours":"1 TO 4 hours.","sections":[{"crn":"77884","code":"M","type":"Lecture-Discussion","partOfTerm":"1","meetings":[{"type":"Lecture-Discussion","days":["M","W","F"],"start":780,"end":830,"location":"122 Davenport Hall","instructors":["Christie, M","Meghani, N"]},{"type":"Lecture-Discussion","days":["M"],"start":840,"end":950,"location":"122 Davenport Hall","instructors":["Christie, M","Meghani, N"]}],"restrictions":[],"note":"Environmental scientists rely on a diverse array of tools, technologies, and analytical techniques to investigate and address environmental challenges. This hands-on field-based course introduces students to essential components of the environmental scientist’s toolkit, including data collection, processing, interpretation, and presentation of findings. Students will gain experience in developing and executing site assessment plans, and use drones, RTK GPS units, LiDAR, surveying equipment, and water quality sensors to gather field data. They will then process and analyze these data using structure-from-motion photogrammetry, ENVI, Google Earth Engine, open-source GIS platforms, and Python-based workflows, and write summaries and recommendations to stakeholders. 4 Credit Hours. Standard letter graded.","title":"Environmnt Scientist’s Toolkit"}]},{"id":"ESE 498","title":"Environmental Writing for Publication","creditHours":"3 hours.","sections":[{"crn":"67478","code":"A","type":"Lecture-Discussion","partOfTerm":"1","meetings":[{"type":"Lecture-Discussion","days":["T","R"],"start":750,"end":830,"location":"G48 Literatures, Cultures, & Ling","instructors":["Cole, L"]}],"restrictions":[],"note":"SP26 - ENGL / ESE 498 - Environmental Writing for Publication - Lucinda Cole - engages students in the real-world editorial process as they develop a polished piece of long-form journalism on an environmental topic of their choice. This final product will showcase students’ professional development as well-informed writers on environmental issues, and may be published in Q Magazine."}]}]