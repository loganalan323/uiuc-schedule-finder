[{"id":"EDUC 199","title":"Undergraduate Open Seminar","creditHours":"0 TO 6 hours.","sections":[{"crn":"71923","code":"LS1","type":"Lecture","partOfTerm":"1","meetings":[{"type":"Lecture","days":["M"],"start":960,"end":1040,"location":"7 Weston Hall","instructors":["Fink, L"]}],"restrictions":[],"note":"EDUC 199, CRN 71923 is looking for college students who want to learn more about education by working with students, teachers, and community leaders. The class meets in person from 4:00 p.m.-5:20 p.m. each Monday for a discussion section. Then, 2-3 hours are spent volunteering, online, working with students in community center settings. Students in EDUC199 will act as tutors and mentors to students in the local community. The instructor of the class has been a teacher in the community for over 25 years. This class is a 2-hour credit class. Contact instructor Lisa Fink with any questions: lsfink@illinois.edu."},{"crn":"74887","code":"N10","type":"Lecture-Discussion","partOfTerm":"1","meetings":[{"type":"Lecture-Discussion","days":["S"],"start":600,"end":1020,"location":"2052 Student Dining & Res Program","instructors":["Cunningham, T","Sanden, N"]},{"type":"Lecture-Discussion","days":["T"],"start":960,"end":1070,"location":"2009 Student Dining & Res Program","instructors":["Cunningham, T","Sanden, N"]}],"restrictions":[],"note":"This class will meet on Saturday, February 8th in Clark 134 AB."},{"crn":"74888","code":"N11","type":"Lecture-Discussion","partOfTerm":"1","meetings":[{"type":"Lecture-Discussion","days":["S"],"start":600,"end":1020,"location":"2003 Student Dining & Res Program","instructors":["Cunningham, T","Sanden, N"]},{"type":"Lecture-Discussion","days":["M"],"start":900,"end":1010,"location":"2003 Student Dining & Res Program","instructors":["Cunningham, T","Sanden, N"]}],"restrictions":[],"note":""},{"crn":"74881","code":"NS0","type":"Lecture-Discussion","partOfTerm":"1","meetings":[{"type":"Lecture-Discussion","days":["S"],"start":600,"end":1020,"loca