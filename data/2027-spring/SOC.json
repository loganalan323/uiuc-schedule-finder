":["M","W"],"start":660,"end":710,"location":"156 Henry Administration Bldg","instructors":["Vogler, S"]},{"type":"Online","days":["F"],"start":660,"end":710,"location":"","instructors":["Vogler, S"]}],"restrictions":[],"note":"This course counts towards the Criminology, Law, and Society (CLS) minor."}]},{"id":"SOC 130","title":"Intro Gender & Women's Studies","creditHours":"3 hours.","sections":[{"crn":"52516","code":"AD1","type":"Discussion/Recitation","partOfTerm":"1","meetings":[{"type":"Discussion/Recitation","days":["F"],"start":600,"end":650,"location":"132 Davenport Hall","instructors":["Barnes, T"]}],"restrictions":[],"note":""},{"crn":"52517","code":"AD2","type":"Discussion/Recitation","partOfTerm":"1","meetings":[{"type":"Discussion/Recitation","days":["F"],"start":660,"end":710,"location":"329 Davenport Hall","instructors":["Barnes, T"]}],"restrictions":[],"note":""},{"crn":"52515","code":"AL1","type":"Lecture","partOfTerm":"1","meetings":[{"type":"Lecture","days":["M","W"],"start":660,"end":710,"location":"302 Architecture Building","instructors":["Barnes, T"]}],"restrictions":[],"note":"Day1Access course materials cost $47.20 For more information see https://go.illinois.edu/Day1Access."}]},{"id":"SOC 160","title":"Global Ineq and Social Change","creditHours":"3 hours.","sections":[{"crn":"65432","code":"1","type":"Lecture","partOfTerm":"1","meetings":[{"type":"Lecture","days":["M","W","F"],"start":840,"end":890,"location":"29 Psychology Building","instructors":[]}],"restrictions":[],"note":""}]},{"id":"SOC 196","title":"Issues in Sociology","creditHours":"3 hours.","sections":[{"crn":"44362","code":"BM","type":"Lecture-Discussion","partOfTerm":"1","meetings":[{"type":"Lecture-Discussion","days":["M","W","F"],"start":840,"end":890,"location":"430 Armory","instructors":["Miles, B"]}],"restrictions":[],"note":"Race, Beauty, and Embodiment: This course will critically interrogate the politics of beauty and embodiment in the United States. Using a variety of theoretical traditions and an interdisciplinary approach, we ask how social meanings around bodies vary across communities and across institutions. Topics we will cover include hair politics, body size, complexion discrimination and colorism, the performance of masculinity and femininity, cosmetic surgery and body modification, gendered and racialized voices, and digital bodies. We will consider beauty ideals and their limitations, changing bodies (i.e., pregnancy, aging, disability), agency, resistance, and empowerment.","title":"Race, Beauty & Embodiment"},{"crn":"39034","code":"KW","type":"Lecture","partOfTerm":"1","meetings":[{"type":"Lecture","days":["T","R"],"start":660,"end":740,"location":"160 English Building","instructors":["Wilkins, K"]}],"restrictions":[],"note":"Topic: Sociology of Native Americans | What does it mean to be indigenous? How do sociologists study indigeneity and nationhood? What does it mean to do \"Indigenous Sociology\"? In this course we explore these questions as we learn about Indigenous Peoples through a sociological lens. Topics covered include (but are not limited to), indigenous sovereignty and nationhood, settler colonialism, racialization of Indigenous Peoples, national and global social problems Indigenous Peoples face, and intersectional experiences of indigeneity. While this course primarily focuses on Indigenous Peoples in the United States (i.e., American Indians, Alaska Natives, and Native Hawaiians) the perspectives and experiences of other Indigenous Peoples (e.g., Indigenous Peoples of Canada, New Zealand, and Australia) are also included.","title":"Sociology of Native Americans"}]},{"id":"SOC 199","title":"Undergraduate Open Seminar","creditHours":"1 TO 5 hours.","sections":[{"crn":"44878","code":"AD2","type":"Lecture","partOfTerm":"1","meetings":[{"type":"Lecture","days":["M"],"start":900,"end":950,"location":"301 Architecture Building","instructors":["Smith, M"]}],"restrictions":[],"note":"Leadership and Engagement course for sociology majors. Develop leadership skills through experiences serving as Ambassadors for the Sociology Department. Prerequisite: SOC 199: Career Development for Sociology Majors.","title":"Ambassador Program"}]},{"id":"SOC 200","title":"Introduction to Sociological Theory","creditHours":"3 hours.","sections":[{"crn":"34357","code":"A","type":"Lecture-Discussion","partOfTerm":"1","meetings":[{"type":"Lecture-Discussion","days":["T","R"],"start":570,"end":650,"location":"3025 Campus Instructional Facility","instructors":["Wilkins, K"]}],"restrictions":[],"note":"Students are strongly recommended to take SOC 100 before enrolling in this course."}]},{"id":"SOC 201","title":"Race, Gender & Power","creditHours":"3 hours.","sections":[{"crn":"71806","code":"DVB","type":"Lecture-Discussion","partOfTerm":"1","meetings":[{"type":"Lecture-Discussion","days":["M","W"],"start":900,"end":980,"location":"302 Architecture Building","instructors":["Vergara Bracamontes, D"]}],"restrictions":[],"note":"This course satisfies the General Education Criteria for a Western/Comparative Cultures course. Meets w/GWS201 (CRN 71805)"}]},{"id":"SOC 202","title":"Sexualities","creditHours":"3 hours.","sections":[{"crn":"56858","code":"CW","type":"Lecture-Discussion","partOfTerm":"1","meetings":[{"type":"Lecture-Discussion","days":["T","R"],"start":840,"end":920,"location":"1027 Lincoln Hall","instructors":["Williams, C"]}],"restrictions":[],"note":"Priority Registration for GWS Majors and Minors. Course will be released following initial registration period."}]},{"id":"SOC 221","title":"Latina/o Migration","creditHours":"3 hours.","sections":[{"crn":"39030","code":"A","type":"Lecture-Discussion","partOfTerm":"1","meetings":[{"type":"Lecture-Discussion","days":["T","R"],"start":780,"end":860,"location":"310 David Kinley Hall","instructors":["Blanco Martinez, S"]}],"restrictions":[],"note":""}]},{"id":"SOC 222","title":"Introduction to Modern Africa","creditHours":"3 hours.","sections":[{"crn":"56393","code":"A","type":"Lecture","partOfTerm":"1","meetings":[{"type":"Discussion/Recitation","days":["F"],"start":780,"end":830,"location":"307 Gregory Hall","instructors":["Toure, V"]},{"type":"Lecture","days":["M","W"],"start":780,"end":830,"location":"307 Gregory Hall","instructors":["Toure, V"]}],"restrictions":[],"note":"Modern Africa has sustained the most rapid and profound changes of any continent in the world. Indeed, the African continent saw its social systems, economic structures, political organizations, and religious and cultural practices profoundly transformed by centuries of European imperialism. Yet, Africa is still largely known in the United States through exotic images of the cultural “other,” decimated by civil wars, clan violence, famine, and HIV/AIDS. This course goes beyond these images and stereotypes to place Africa and its people within the shared history of an increasingly global world. The course will utilize an interdisciplinary framework to examine the great civilizations of pre-colonial African societies; the trans-Atlantic slave trade; the impact of colonialism, nationalism, Pan-Africanism, and nationalist and independence movements; social movements and democratization; gender and development; the role of the African Diaspora in Africa's development; and globalization. This course fulfills a general education requirement for Cultural Studies: Non-Western and American Minority Cultures, as well as Social Science."}]},{"id":"SOC 223","title":"Black Women Contemp US Society","creditHours":"3 hours.","sections":[{"crn":"63817","code":"DMC","type":"Lecture-Discussion","partOfTerm":"1","meetings":[{"type":"Lecture-Discussion","days":["T","R"],"start":660,"end":740,"location":"214 Davenport Hall","instructors":["Riley, J"]}],"restrictions":[],"note":""}]},{"id":"SOC 225","title":"Race and Ethnicity","creditHours":"3 hours.","sections":[{"crn":"46859","code":"A","type":"Lecture-Discussion","partOfTerm":"1","meetings":[{"type":"Lecture-Discussion","days":["M","W","F"],"start":780,"end":830,"location":"333 Armory","instructors":["Miles, B"]}],"restrictions":[],"note":"This course counts towards the Criminology, Law, and Society (CLS) minor."}]},{"id":"SOC 230","title":"The Sociology of Political Polarization: Bigots and Snowflakes","creditHours":"3 hours.","sections":[{"crn":"72884","code":"IR","type":"Lecture-Discussion","partOfTerm":"1","meetings":[{"type":"Lecture-Discussion","days":["T","R"],"start":660,"end":740,"location":"302 Architecture Building","instructors":["Redstone, I"]}],"restrictions":[],"note":""}]},{"id":"SOC 274","title":"Health, Illness and Society","creditHours":"3 hours.","sections":[{"crn":"38967","code":"A","type":"Lecture-Discussion","partOfTerm":"1","meetings":[{"type":"Lecture-Discussion","days":["M","W","F"],"start":600,"end":650,"location":"207 Psychology Building","instructors":["Kamis, C"]}],"restrictions":[],"note":""}]},{"id":"SOC 275","title":"Criminology","creditHours":"3 hours.","sections":[{"crn":"69391","code":"A","type":"Lecture","partOfTerm":"1","meetings":[{"type":"Lecture","days":["M","W","F"],"start":660,"end":710,"location":"160 English Building","instructors":["Janson, L"]}],"restrictions":[],"note":"This course counts towards the Criminology, Law, and Society (CLS) minor."}]},{"id":"SOC 280","title":"Intro to Social Statistics","creditHours":"4 hours.","sections":[{"crn":"34351","code":"A","type":"Lecture","partOfTerm":"1","meetings":[{"type":"Lecture","days":["T","R"],"start":570,"end":650,"location":"302 Architecture Building","instructors":["Redstone, I"]}],"restrictions":[],"note":""},{"crn":"34344","code":"AB1","type":"Laboratory","partOfTerm":"1","meetings":[{"type":"Laboratory","days":["F"],"start":540,"end":590,"location":"146 Armory","instructors":["Redstone, I"]}],"restrictions":[],"note":""},{"crn":"34346","code":"AB2","type":"Laboratory","partOfTerm":"1","meetings":[{"type":"Laboratory","days":["W"],"start":840,"end":890,"location":"146 Armory","instructors":["Redstone, I"]}],"restrictions":[],"note":""}]},{"id":"SOC 310","title":"Sociology of Deviance","creditHours":"3 hours.","sections":[{"crn":"77002","code":"01","type":"Lecture-Discussion","partOfTerm":"1","meetings":[{"type":"Lecture-Discussion","days":["M","W","F"],"start":600,"end":650,"location":"160 English Building","instructors":["Janson, L"]}],"restrictions":[],"note":"This course counts toward the Criminology, Law, and Society (CLS) minor."}]},{"id":"SOC 325","title":"Black Men and Masculinities","creditHours":"3 hours.","sections":[{"crn":"43468","code":"A","type":"Lecture-Discussion","partOfTerm":"1","meetings":[{"type":"Lecture-Discussion","days":["T","R"],"start":750,"end":830,"location":"1068 Lincoln Hall","instructors":["Nance, C"]}],"restrictions":[],"note":""}]},{"id":"SOC 350","title":"Technology and Society","creditHours":"3 hours.","sections":[{"crn":"53563","code":"A","type":"Lecture-Discussion","partOfTerm":"1","meetings":[{"type":"Lecture-Discussion","days":["T","R"],"start":570,"end":650,"location":"162 Education Building","instructors":["Lee, J"]}],"restrictions":[],"note":""}]},{"id":"SOC 355","title":"Race and Mixed Race","creditHours":"3 hours.","sections":[{"crn":"57161","code":"A","type":"Lecture-Discussion","partOfTerm":"1","meetings":[{"type":"Lecture-Discussion","days":["T","R"],"start":840,"end":920,"location":"103 1207 W Oregon","instructors":["Rodriguez, R"]}],"restrictions":[],"note":""}]},{"id":"SOC 375","title":"Criminal Justice System","creditHours":"3 hours.","sections":[{"crn":"69187","code":"AMM","type":"Lecture-Discussion","partOfTerm":"1","meetings":[{"type":"Lecture-Discussion","days":["M","W","F"],"start":780,"end":830,"location":"319 Gregory Hall","instructors":[]}],"restrictions":[],"note":"This course counts towards the Criminology, Law, and Society (CLS) minor."}]},{"id":"SOC 380","title":"Social Research Methods","creditHours":"4 hours.","sections":[{"crn":"34385","code":"AD1","type":"Discussion/Recitation","partOfTerm":"1","meetings":[{"type":"Discussion/Recitation","days":["F"],"start":780,"end":830,"location":"327 Gregory Hall","instructors":["Wu, M"]}],"restrictions":[],"note":""},{"crn":"34390","code":"AD2","type":"Discussion/Recitation","partOfTerm":"1","meetings":[{"type":"Discussion/Recitation","days":["F"],"start":600,"end":650,"location":"331 Gregory Hall","instructors":["Wu, M"]}],"restrictions":[],"note":""},{"crn":"34393","code":"AL1","type":"Lecture","partOfTerm":"1","meetings":[{"type":"Lecture","days":["M","W","F"],"start":660,"end":710,"location":"223 Gregory Hall","instructors":["Wu, M"]}],"restrictions":[],"note":""}]},{"id":"SOC 390","title":"Individual Study","creditHours":"1 TO 6 hours.","sections":[{"crn":"10043","code":"","type":"Independent Study","partOfTerm":"1","meetings":[{"type":"Independent Study","days":[],"start":null,"end":null,"location":"Location Pending","instructors":[]}],"restrictions":[],"note":""}]},{"id":"SOC 396","title":"Topics in Sociology","creditHours":"3 hours.","sections":[{"crn":"53281","code":"LPC","type":"Lecture-Discussion","partOfTerm":"1","meetings":[{"type":"Lecture-Discussion","days":["T","R"],"start":660,"end":740,"location":"140 Burrill Hall","instructors":["Steward, D"]}],"restrictions":[],"note":"We will study law and literature, law in the cinema, and law in other media (TV, streaming, games). We will also study how laws shape amateur culture, the role of legal pundits, civics education, and jokes about lawyers. This course will count towards the CLS minor.","title":"Law & Popular Culture"}]},{"id":"SOC 400","title":"Internships","creditHours":"0 TO 3 hours.","sections":[{"crn":"10051","code":"ADV","type":"Internship","partOfTerm":"1","meetings":[{"type":"Internship","days":[],"start":null,"end":null,"location":"Location Pending","instructors":["Smith, M"]}],"restrictions":[],"note":"Sophomore, Junior, or Senior Standing Completion of SOC 100 or 101 or 163, SOC 200, + 3 additional hours in SOC.","title":"Sociology Internship"}]},{"id":"SOC 450","title":"Senior Capstone Seminar","creditHours":"3 hours.","sections":[{"crn":"67640","code":"CAP","type":"Lecture","partOfTerm":"1","meetings":[{"type":"Lecture","days":["T","R"],"start":840,"end":920,"location":"209 David Kinley Hall","instructors":["Liao, T"]}],"restrictions":[],"note":"This course meets with SOC 495."}]},{"id":"SOC 470","title":"Social Movements","creditHours":"2 TO 4 hours.","sections":[{"crn":"34408","code":"A","type":"Lecture-Discussion","partOfTerm":"1","meetings":[{"type":"Lecture-Discussion","days":["M","W","F"],"start":600,"end":650,"location":"312 David Kinley Hall","instructors":["Hamideh, A"]}],"restrictions":[],"note":"This section is for Undergraduate Students only"}]},{"id":"SOC 479","title":"Law and Society","creditHours":"3 OR 4 hours.","sections":[{"crn":"69189","code":"UG","type":"Lecture","partOfTerm":"1","meetings":[{"type":"Lecture","days":["T","R"],"start":570,"end":650,"location":"2101 Everitt Laboratory","instructors":["Steward, D"]}],"restrictions":[],"note":"This course counts towards the Criminology, Law, and Society (CLS) minor."}]},{"id":"SOC 490","title":"Advanced Independent Study","creditHours":"3 hours.","sections":[{"crn":"10046","code":"","type":"Independent Study","partOfTerm":"1","meetings":[{"type":"Independent Study","days":[],"start":null,"end":null,"location":"Location Pending","instructors":[]}],"restrictions":[],"note":""}]},{"id":"SOC 495","title":"Senior Honors Seminar","creditHours":"3 hours.","sections":[{"crn":"34397","code":"A","type":"Lecture","partOfTerm":"1","meetings":[{"type":"Lecture","days":["T","R"],"start":840,"end":920,"location":"307 English Building","instructors":["Liao, T"]}],"restrictions":[],"note":"This course meets with SOC 450. Permission to register for this course is required. Please reach out to the Sociology Undergraduate Advising office for approval process."}]},{"id":"SOC 496","title":"Advanced Topics in Sociology","creditHours":"3 hours.","sections":[{"crn":"52327","code":"DS","type":"Lecture-Discussion","partOfTerm":"1","meetings":[{"type":"Lecture-Discussion","days":["T","R"],"start":840,"end":920,"location":"113 David Kinley Hall","instructors":["Steward, D"]}],"restrictions":[],"note":"Topic: Law and the Social Construction of Property. Credit will not be provided for both this course and SOC 396 Law and the Commons. This course counts towards the Criminology, Law and Society minor. We will study the significance of law and legal institutions in shaping our understanding of property, both \"natural\" and \"artificial.\" We will look back to the enclosure movements and also look forward to a digital public domain.","title":"Law & Soc Const of Property"},{"crn":"34469","code":"JA","type":"Lecture-Discussion","partOfTerm":"1","meetings":[{"type":"Lecture-Discussion","days":["T","R"],"start":750,"end":830,"location":"319 Gregory Hall","instructors":["Atiles Osoria, J"]}],"restrictions":["Not intended for Graduate - Urbana-Champaign."],"note":"Crimes of the Powerful: This course examines crimes committed by powerful individuals, corporations, states, and global institutions, shifting the criminological focus to the forms of harm that often produce the greatest social and economic consequences. Through the study of organized crime, white-collar crime, state and corporate crime, corruption and financial crime, and digital and environmental harms, students will critically analyze how power-dynamics shapes the definition and enforcement of law. Emphasizing contemporary case studies, the course explores why many of the most harmful acts remain normalized, under-regulated, or beyond the reach of justice. This course counts for elective credit towards the Criminology, Law, and Society Minor.","title":"Crimes of the Powerful"},{"crn":"34468","code":"SV","type":"Packaged Section","partOfTerm":"1","meetings":[{"type":"Packaged Section","days":["F"],"start":840,"end":890,"location":"Location Pending","instructors":["Vogler, S"]},{"type":"Packaged Section","days":["M","W"],"start":840,"end":890,"location":"Location Pending","instructors":["Vogler, S"]}],"restrictions":["Restricted to Undergrad - Urbana-Champaign."],"note":"Title: Gender, Sexuality and Law. This class offers an introduction to the relationship between gender, sexuality, and law in the United States, both historically and currently. We will examine how the law has reflected and created distinctions on the basis of gender and sexuality and how such distinctions contribute to social inequalities. We will also explore how feminist and queer activists have resisted legally produced inequalities and whether (or how) their efforts have created enduring social change. Some of the topics we will consider include marriage, sex work, reproduction, employment and the workplace, anti-violence movements, consent, immigration and citizenship, and everyday forms of discrimination. All materials and readings will be provided via Canvas. Class will meet in person M, W, and online on F. Note: \"SOC 496 Gender, Sexuality, and Law\" will count towards the CLS minor.","title":"Gender, Sexuality and Law"}]},{"id":"SOC 503","title":"Social Theory","creditHours":"4 hours.","sections":[{"crn":"78777","code":"A","type":"Lecture-Discussion","partOfTerm":"1","meetings":[{"type":"Lecture-Discussion","days":["T"],"start":930,"end":1130,"location":"Location Pending","instructors":["Atiles Osoria, J"]}],"restrictions":[],"note":""}]},{"id":"SOC 510","title":"Professionalization Seminar","creditHours":"2 hours.","sections":[{"crn":"51765","code":"A","type":"Lecture","partOfTerm":"1","meetings":[{"type":"Lecture","days":["T"],"start":780,"end":830,"location":"125 English Building","instructors":["Soener, M"]}],"restrictions":[],"note":"This is the Sociology Teaching Practicum restricted to first year Sociology Graduate Students. NOTE: This course will meet once every two weeks. The credit hours remain the same."}]},{"id":"SOC 531","title":"Sociological Survey","creditHours":"4 hours.","sections":[{"crn":"78771","code":"A","type":"Lecture-Discussion","partOfTerm":"1","meetings":[{"type":"Lecture-Discussion","days":["T","R"],"start":480,"end":590,"location":"309 English Building","instructors":["May, R"]}],"restrictions":[],"note":""}]},{"id":"SOC 575","title":"Founds of Organizational Behav","creditHours":"4 hours.","sections":[{"crn":"52785","code":"A","type":"Lecture-Discussion","partOfTerm":"1","meetings":[{"type":"Lecture-Discussion","days":["T"],"start":780,"end":950,"location":"104 Irwin Doctoral Hall","instructors":["Ocasio, W"]}],"restrictions":[],"note":"This course will meet in 3015/3017 BIF."}]},{"id":"SOC 585","title":"Social Data and Statistics","creditHours":"4 hours.","sections":[{"crn":"78776","code":"A","type":"Lecture-Discussion","partOfTerm":"1","meetings":[{"type":"Lecture-Discussion","days":["W"],"start":930,"end":1130,"location":"109 Sch of Info Sciences Bldg","instructors":["Kamis, C"]}],"restrictions":[],"note":""}]},{"id":"SOC 590","title":"Individual Topics in Sociology","creditHours":"1 TO 8 hours.","sections":[{"crn":"10054","code":"","type":"Independent Study","partOfTerm":"1","meetings":[{"type":"Independent Study","days":[],"start":null,"end":null,"location":"Location Pending","instructors":[]}],"restrictions":[],"note":""}]},{"id":"SOC 596","title":"Recent Developments in Soc","creditHours":"4 hours.","sections":[{"crn":"61112","code":"GE","type":"Lecture-Discussion","partOfTerm":"1","meetings":[{"type":"Lecture-Discussion","days":["M"],"start":930,"end":1130,"location":"Location Pending","instructors":["Lee, J"]}],"restrictions":[],"note":"Topic: Sociology of Culture Welcome to the course Sociology of Culture. We will be exploring questions such as: What makes popular culture popular? What makes something 'cool' or 'uncool'? Can my hobby make me more hireable? What's so special about high arts?","title":"Sociology of Culture"}]},{"id":"SOC 597",