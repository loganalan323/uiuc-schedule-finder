pe":"Lecture-Discussion","days":["T","R"],"start":750,"end":830,"location":"292 Animal Sciences Laboratory","instructors":["Bresolin, T"]}],"restrictions":[],"note":"This course provides a basic foundation of different topics in genomics, including genome sequencing and annotation, gene mapping, genome prediction, gene expression analyses, inference of gene networks, and integration of multi-omics data. It also provides an overview of the benefits of genomics on agriculture and human health.","title":"Genomics for Beginners"},{"crn":"62395","code":"TC","type":"Lecture","partOfTerm":"1","meetings":[{"type":"Laboratory","days":["W","F"],"start":540,"end":650,"location":"ARR Animal Sciences Laboratory","instructors":["Crofts, T"]},{"type":"Lecture","days":["M"],"start":540,"end":590,"location":"404 Animal Sciences Laboratory","instructors":["Crofts, T"]}],"restrictions":[],"note":"Students wishing to take the course should have introductory microbiology/molecular biology (e.g. MCB 100 or MCB 150) and introductory lab (e.g., MCB 101 or MCB 151) or equivalent course experience. Interested students may contact Dr. Crofts to discuss exceptions to these prerequisites. This course will be held in Animal Sciences Laboratory Room 322.","title":"Antibiotics & Antibiotic Resis"}]},{"id":"ANSC 500","title":"Feeds in Dairy Nutrition and Diet Formulation","creditHours":"4 hours.","sections":[{"crn":"77207","code":"ONL","type":"Online","partOfTerm":"A","meetings":[{"type":"Online","days":["M"],"start":960,"end":1050,"location":"","instructors":["Cardoso, P","McCann, J"]}],"restrictions":[],"note":"Completion of this course requires the use of Canvas, Zoom, and Coursera (Coursera requires additional ID verification). This is a hybrid online course that includes asynchronous content and a weekly synchronous (live) online session. The live sessions will also be recorded and available on the Canvas course site."}]},{"id":"ANSC 501","title":"Nutritional Impact on Cow Health and Disorders","creditHours":"4 hours.","sections":[{"crn":"77609","code":"ONL","type":"Online","partOfTerm":"B","meetings":[{"type":"Online","days":[],"start":null,"end":null,"location":"","instructors":["Condotta, I","Loor, J"]}],"restrictions":[],"note":"Completion of this course requires the use of Canvas, Zoom, and Coursera (Coursera requires additional ID verification). Restricted to Animal Sciences, MANSC, and the Dairy Nutrition for Udder Success CERT. Non-degree graduate students are eligible to enroll in the course."}]},{"id":"ANSC 515","title":"Bovine Assisted Reproductive Technologies","creditHours":"2 hours.","sections":[{"crn":"78341","code":"MBW","type":"Lecture-Discussion","partOfTerm":"B","meetings":[{"type":"Lecture-Discussion","days":["W"],"start":540,"end":620,"location":"396 Animal Sciences Laboratory","instructors":["Allen, C","Wheeler, M"]}],"restrictions":[],"note":"The class will meet Wednesdays, March 24-May 5 with one 80-minute weekly virtual discussion. This is a 2-credit hour course with both online asynchronous and in-person synchronous components. Students will complete asynchronous lecture content online in addition to a synchronous in-person discussion meeting once per week on Wednesday from 9:00-10:20 AM. Off-campus students may join the discussion via Zoom. Students on campus are expected to attend in person. The course will cover reproductive technology and techniques utilized in cattle, including Bos taurus and Bos indicus. Topics include general bovine reproductive anatomy and physiology, estrus detection, estrous cycle control, estrus synchronization, pregnancy diagnosis, nutrition and disease concerns, collecting eggs and sperm, semen processing, in vitro and in vivo embryo production and emerging assisted reproductive technologies such as AI, IVF, MOET. The prerequisite for this course is ANSC 224."}]},{"id":"ANSC 520","title":"Protein and Energy Nutrition","creditHours":"3 hours.","sections":[{"crn":"29990","code":"A","type":"Lecture","p