R"],"start":750,"end":830,"location":"W109 Turner Hall","instructors":["Kuenstler, A"]}],"restrictions":[],"note":"Polymer Synthesis and Industrial Applications. Meets with CHBE 594 ASK."}]},{"id":"CHBE 458","title":"Synthetic Nanomaterials","creditHours":"3 hours.","sections":[{"crn":"71942","code":"HY2","type":"Lecture","partOfTerm":"1","meetings":[{"type":"Lecture","days":["T","R"],"start":570,"end":650,"location":"393 Bevier Hall","instructors":["Yang, H"]}],"restrictions":[],"note":"Synthetic Nanomaterials. Meets with CHBE 594 HY2."}]},{"id":"CHBE 478","title":"Bioenergy Technology","creditHours":"3 hours.","sections":[{"crn":"61796","code":"A","type":"Lecture","partOfTerm":"1","meetings":[{"type":"Lecture","days":["T","R"],"start":660,"end":740,"location":"108 English Building","instructors":["Shukla, D"]}],"restrictions":[],"note":"Meets with CHBE 594 A."}]},{"id":"CHBE 494","title":"Special Topics","creditHours":"1 TO 3 hours.","sections":[{"crn":"69169","code":"PHA","type":"Lecture","partOfTerm":"1","meetings":[{"type":"Lecture","days":["M","W","F"],"start":540,"end":590,"location":"2036 Campus Instructional Facility","instructors":["Burcham, C"]}],"restrictions":[],"note":"Pharmaceutical Engineering. Course focuses on the development and manufacture of small molecule pharmaceutical products. The course will cover solid oral dosage forms, sterile formulations and active pharmaceutical ingredients produced by traditional synthetic chemistry approaches. Intellectual property considerations, as well as regulatory requirements constraining the industry are considered. The class follows the pathway from molecule discovery through the development of the active pharmaceutical ingredient, formulated drug product and the commercial manufacture of both the drug substance and the drug product. Meets with CHBE 594 PHA.","title":"Pharmaceutical Engineering"}]},{"id":"CHBE 497","title":"Individual Study for Seniors","creditHours":"1 TO 3 hours.","sections":[{"crn":"45094","code":"","type":"Independent Study","partOfTerm":"1","meetings":[{"type":"Independent Study","days":[],"start":null,"end":null,"location":"Location Pending","instructors":[]}],"restrictions":[],"note":""}]},{"id":"CHBE 499","title":"Senior Thesis","creditHours":"1 TO 6 hours.","sections":[{"crn":"10482","code":"","type":"Independent Study","partOfTerm":"1","meetings":[{"type":"Independent Study","days":[],"start":null,"end":null,"location":"Location Pending","instructors":[]}],"restrictions":[],"note":""}]},{"id":"CHBE 510","title":"Graduate CHBE Internship","creditHours":"0 hours.","sections":[{"crn":"68619","code":"A","type":"Internship","partOfTerm":"1","meetings":[{"type":"Internship","days":[],"start":null,"end":null,"location":"Location Pending","instructors":["Simpson, P"]}],"restrictions":[],"note":""}]},{"id":"CHBE 523","title":"Heat and Mass Transfer","creditHours":"3 OR 4 hours.","sections":[{"crn":"32132","code":"A","type":"Lecture","partOfTerm":"1","meetings":[{"type":"Lecture","days":["T","R"],"start":570,"end":650,"location":"163 Noyes Laboratory","instructors":["Kong, H"]}],"restrictions":[],"note":"Day1Access course materials cost $47.29. For more information see https://go.illinois.edu/Day1Access."}]},{"id":"CHBE 565","title":"CHBE Seminar","creditHours":"1 hours.","sections":[{"crn":"32047","code":"A","type":"Lecture-Discussion","partOfTerm":"1","meetings":[{"type":"Lecture-Discussion","days":["T","R"],"start":840,"end":920,"location":"116 Roger Adams Laboratory","instructors":["Kuenstler, A"]}],"restrictions":[],"note":""}]},{"id":"CHBE 571","title":"Bioinformatics","creditHours":"4 hours.","sections":[{"crn":"61909","code":"A1","type":"Lecture-Discussion","partOfTerm":"1","meetings":[{"type":"Lecture-Discussion","days":["T","R"],"start":840,"end":920,"location":"136 Loomis Laboratory","instructors":["Zhao, S"]}],"restrictions":[],"note":"For up-to-date information about statistics course registration, please see our registration update pages: go.illinois.edu/StatisticsRegistration. Introduction to statistical methods used in the analysis of genomic data. Methods are organized around data types commonly found in biological experiments, such as genotype data, gene expression levels, histone modifications, and microbiome data. Emphasis on statistical understanding. Practical implementation will be illustrated in R. Prerequisites: STAT 410, STAT 420, thorough knowledge of R."}]},{"id":"CHBE 582","title":"Business Value and Skills Application","creditHours":"1 hours.","sections":[{"crn":"78138","code":"B","type":"Lecture","partOfTerm":"B","meetings":[{"type":"Lecture","days":[],"start":null,"end":null,"location":"Location Pending","instructors":["Morris, J"]}],"restrictions":["Restricted to MENG:Engr:Chem Engr Lead-UIUC."],"note":""},{"crn":"78139","code":"C","type":"Online","partOfTerm":"B","meetings":[{"type":"Online","days":[],"start":null,"end":null,"location":"","instructors":["Morris, J"]}],"restrictions":["Restricted to MENG:Engr:ChemEngLead ONL-UIUC."],"note":""}]},{"id":"CHBE 593","title":"Individual Study","creditHours":"0 TO 4 hours.","sections":[{"crn":"10484","code":"","type":"Independent Study","partOfTerm":"1","meetings":[{"type":"Independent Study","days":[],"start":null,"end":null,"location":"Location Pending","instructors":[]}],"restrictions":[],"note":""}]},{"id":"CHBE 594","title":"Special Topics","creditHours":"1 TO 4 hours.","sections":[{"crn":"41431","code":"A","type":"Lecture","partOfTerm":"1","meetings":[{"type":"Lecture","days":["T","R"],"start":660,"end":740,"location":"108 English Building","instructors":["Shukla, D"]}],"restrictions":[],"note":"Special Topics: Bioenergy Technology. Meets with CHBE 478 A. Introduction to emerging bioenergy technologies including: world energy consumption and greenhouse gas concerns; fundamental biochemistry of biomass conversion; structural chemistry of lignocelluloses; pretreatment of biomass; enzymatic deconstruction; bioethanol production and fermentation; metabolic engineering for improved biofuels production; feedstock development; industrial fermentation and fermentor design; economics of bioethanol; alternative biofuels, including biodiesel, syngas, Fischer-Tropsch diesel, butanol, ABE fermentation and biohydrogen; anaerobic microbiology; and the biorefinery concept. Meets with CHBE 478 A.","title":"Bioenergy Technology"},{"crn":"68622","code":"ASK","type":"Lecture","partOfTerm":"1","meetings":[{"type":"Lecture","days":["T","R"],"start":750,"end":830,"location":"W109 Turner Hall","instructors":["Kuenstler, A"]}],"restrictions":["Restricted to Chemical Engineering major(s)."],"note":"Polymer Synthesis and Industrial Applications. Meets with CHBE 455.","title":"Polymer Synthesis and Ind Apps"},{"crn":"44876","code":"DS","type":"Lecture","partOfTerm":"1","meetings":[{"type":"Lecture","days":["T","R"],"start":900,"end":980,"location":"106B3 Engineering Hall","instructors":["Jackson, N"]}],"restrictions":[],"note":"Meets with CHBE 413 Data Science for Chemistry and Engineering and CHEM 452 Data Science for Chemistry and Engineering. This course serves as an introduction to data-driven and machine learning techniques in chemistry and chemical engineering. Surveyed topics will include standard regression and classification algorithms, neural network architectures, unsupervised learning, clustering, molecular featurization techniques and best practices for machine learning. The course serves as a practical introduction to these techniques in Python using existing chemical datasets.","title":"Data Science for Chem & Eng"},{"crn":"71943","code":"HY2","type":"Lecture","partOfTerm":"1","meetings":[{"type":"Lecture","days":["T","R"],"start":570,"end":650,"location":"393 Bevier Hall","instructors":["Yang, H"]}],"restrictions":["Restricted to Chemical Engineering major(s)."],"note":"Synthetic Nanomaterials. Meets with CHBE 458. This course is focused on introducing the concepts related to the fundamentals and practical methods for the preparation of nanostructured materials. Classical nucleation and growth, interfacial science, crystal structures, and characterization techniques are among some of the topics covered. The emphasis will be placed on the synthesis of nanostructures in solution with the processing controls of size, shape (dot, wire, and two-dimensional materials), facet, composition, and hierarchical structure. Students will also be exposed to related current topics, including the applications of well-defined nanoparticles in energy, sustainability, and biotechnology.","title":"Synthetic Nanomaterials"},{"crn":"69170","code":"PHA","type":"Lecture","partOfTerm":"1","meetings":[{"type":"Lecture","days":["M","W","F"],"start":540,"end":590,"location":"2036 Campus Instructional Facility","instructors":["Burcham, C"]}],"restrictions":[],"note":"Pharmaceutical Engineering. Course focuses on the development and manufacture of small molecule pharmaceutical products. The course will cover solid oral dosage forms, sterile formulations and active pharmaceutical ingredients produced by traditional synthetic chemistry approaches. Intellectual property considerations, as well as regulatory requirements constraining the industry are considered. The class follows the pathway from molecule discovery through the development of the active pharmaceutical ingredient, formulated drug product and the commercial manufacture of both the drug substance and the drug product. Meets with CHBE 494 PHA.","title":"Pharmaceutical Engineering"},{"crn":"32048","code":"TS","type":"Lecture","partOfTerm":"1","meetings":[{"type":"Lecture","days":["T","R"],"start":570,"end":650,"location":"132 Bevier Hall","instructors":["Schoetz, T"]}],"restrictions":[],"note":"Electrochemical Engineering. Meets with CHBE 453 TS.","title":"Electrochemical Engineering"}]},{"id":"CHBE 597","title":"Special Problems","creditHours":"2 TO 16 hours.","sections":[{"crn":"10498","code":"","type":"Independent Study","partOfTerm":"1","meetings":[{"type":"Independent Study","days":[],"start":null,"end":null,"location":"Location Pending","instructors":[]}],"restrictions":[],"note":""}]},{"id":"CHBE 598","title":"Research Seminar","creditHours":"0 TO 4 hours.","sections":[{"crn":"10501","code":"","type":"Independent Study","partOfTerm":"1","meetings":[{"type":"Independent Study","days":[],"start":null,"end":null,"location":"Location Pending","instructors":[]}],"restrictions":[],"note":""}]}]