ng","instructors":["Briggs, M"]}],"restrictions":["Restricted to Graphic Design or Design for Responsible Innov major(s) or minor(s).","Restricted to Graduate - Urbana-Champaign."],"note":"Graduate Section."}]},{"id":"ARTD 471","title":"Graphic Design Capstone","creditHours":"3 hours.","sections":[{"crn":"65182","code":"GD1","type":"Studio","partOfTerm":"1","meetings":[{"type":"Studio","days":["M","W"],"start":780,"end":940,"location":"107 Art and Design Building","instructors":["Marble, J"]}],"restrictions":["Restricted to Graphic Design major(s)."],"note":""},{"crn":"65474","code":"GD2","type":"Studio","partOfTerm":"1","meetings":[{"type":"Studio","days":["T","R"],"start":570,"end":730,"location":"216 Art and Design Building","instructors":["Marble, J"]}],"restrictions":["Restricted to Graphic Design major(s)."],"note":""},{"crn":"72182","code":"GD3","type":"Studio","partOfTerm":"1","meetings":[{"type":"Studio","days":["T","R"],"start":840,"end":1000,"location":"404 Flagg Hall","instructors":["Thomas, N"]}],"restrictions":["Restricted to Graphic Design major(s) or minor(s)."],"note":""}]},{"id":"ARTD 499","title":"Special Topics in Design","creditHours":"1 TO 4 hours.","sections":[{"crn":"57936","code":"SS","type":"Laboratory-Discussion","partOfTerm":"1","meetings":[{"type":"Laboratory-Discussion","days":["T"],"start":1020,"end":1180,"location":"107 Art and Design Building","instructors":["Sethi, S"]}],"restrictions":[],"note":"This course invites design students to explore the intersection of artificial intelligence, emotion, and storytelling in shaping the next generation of products and services. Students will learn how to design for AI-driven experiences that go beyond technical function, emphasizing emotional resonance and human connection. Through critical engagement with contemporary debates on AI, the course highlights the role of emotional intelligence and narrative in creating empathetic, meaningful, and human-centered AI design solutions. This course is open for enrollment to students from engineering, architecture, and both graduate and undergraduate students at the senior/junior level."}]},{"id":"ARTD 502","title":"Industrial Design II: From Ideation to Implementation","creditHours":"6 hours.","sections":[{"crn":"50480","code":"M4","type":"Studio","partOfTerm":"1","meetings":[{"type":"Studio","days":["T","R"],"start":840,"end":1000,"location":"405 Flagg Hall","instructors":["Sethi, S"]}],"restrictions":[],"note":""}]},{"id":"ARTD 503","title":"Industrial Design III: Design Project Formulation","creditHours":"6 hours.","sections":[{"crn":"72115","code":"1","type":"Studio","partOfTerm":"1","meetings":[{"type":"Studio","days":["T","R"],"start":570,"end":730,"location":"405 Flagg Hall","instructors":["Marcelino, C"]}],"restrictions":[],"note":""}]},{"id":"ARTD 591","title":"Special Problems in Design","creditHours":"1 TO 8 hours.","sections":[{"crn":"10376","code":"","type":"Independent Study","partOfTerm":"1","meetings":[{"type":"Independent Study","days":[],"start":null,"end":null,"location":"Location Pending","instructors":[]}],"restrictions":[],"note":""},{"crn":"12261","code":"HRI","type":"Seminar","partOfTerm":"1","meetings":[{"type":"Seminar","days":["T"],"start":660,"end":830,"location":"340 Art and Design Building","instructors":["Baul, D","Taher, M"]}],"restrictions":[],"note":"Living Between Worlds: Women, Migration and the City Living Between Worlds investigates the city as a space of marginal experiences across time and transnational contexts. This seminar probes open-ended ways of rethinking the urban, mainly by foregrounding the experiences of South Asian women in native and diasporic spaces. We experiment with a mix of learning methods that can register embodied, artistic, and archival forms of knowledge. By centering lived experiences from the periphery, this course asks: How do cities accommodate (and erase) women’s labor, mobility, solidarity, and pleasure as spatial practice? In situating South Asian women as subjects, we build on feminist, anti-racist, and post-colonial critiques of dominant, eurocentric ways of imagining urban space."}]},{"id":"ARTD 595","title":"MFA Design for Responsible Innovation Studio","creditHours":"4 hours.","sections":[{"crn":"30512","code":"A","type":"Studio","partOfTerm":"1","meetings":[{"type":"Studio","days":["M","W"],"start":780,"end":940,"location":"420 Flagg Hall","instructors":["Benson, E"]}],"restrictions":[],"note":""}]}]