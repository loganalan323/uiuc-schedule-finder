:["Ramirez, N","Reagan, L"]}],"restrictions":[],"note":""},{"crn":"74150","code":"AD2","type":"Discussion/Recitation","partOfTerm":"1","meetings":[{"type":"Discussion/Recitation","days":["F"],"start":780,"end":830,"location":"331 Gregory Hall","instructors":["Horan, K","Reagan, L"]}],"restrictions":[],"note":""},{"crn":"74152","code":"AD3","type":"Discussion/Recitation","partOfTerm":"1","meetings":[{"type":"Discussion/Recitation","days":["W"],"start":900,"end":950,"location":"221 Gregory Hall","instructors":["Ramirez, N","Reagan, L"]}],"restrictions":[],"note":""},{"crn":"74154","code":"AD4","type":"Discussion/Recitation","partOfTerm":"1","meetings":[{"type":"Discussion/Recitation","days":["R"],"start":660,"end":710,"location":"222 David Kinley Hall","instructors":["Horan, K","Reagan, L"]}],"restrictions":[],"note":""},{"crn":"74552","code":"AD5","type":"Discussion/Recitation","partOfTerm":"1","meetings":[{"type":"Discussion/Recitation","days":["F"],"start":540,"end":590,"location":"313 Gregory Hall","instructors":["Ramirez, N","Reagan, L"]}],"restrictions":[],"note":""},{"crn":"74553","code":"AD6","type":"Discussion/Recitation","partOfTerm":"1","meetings":[{"type":"Discussion/Recitation","days":["R"],"start":570,"end":620,"location":"217 Gregory Hall","instructors":["Horan, K","Reagan, L"]}],"restrictions":[],"note":""},{"crn":"74146","code":"AL1","type":"Lecture","partOfTerm":"1","meetings":[{"type":"Lecture","days":["M","W"],"start":780,"end":830,"location":"23 Psychology Building","instructors":["Reagan, L"]}],"restrictions":[],"note":""}]},{"id":"GWS 272","title":"Women and Politics","creditHours":"3 hours.","sections":[{"crn":"78903","code":"A","type":"Lecture-Discussion","partOfTerm":"1","meetings":[{"type":"Lecture-Discussion","days":["T","R"],"start":840,"end":920,"location":"319 Gregory Hall","instructors":["Cohen, E"]}],"restrictions":[],"note":""}]},{"id":"GWS 280","title":"Women Writers","creditHours":"3 hours.","sections":[{"crn":"32106","code":"K","type":"Lecture-Discussion","partOfTerm":"1","meetings":[{"type":"Lecture-Discussion","days":["T","R"],"start":660,"end":735,"location":"303 English Building","instructors":["Mack, K"]}],"restrictions":[],"note":"SP27 ENGL / GWS 280 - African American Women Writers - In this seminar, students examine the ways in which 19th- and 20th-century African American women writers, such as Zora Neale Hurston, Alice Walker, Toni Morrison, and Audre Lorde have articulated notions of womanhood, femininity, and American citizenship through their representations of Black female narrators and characters. The class will begin with Iola Leroy, or Shadows Uplifted by Frances Harper (1892)—one of the first novels published by an African American woman—and end with Sarah Phillips by Andrea Lee (1984). Through this course, we explore the historical marginalization and silencing of Black women’s voices in the American literary canon, not only engaging Black women’s literature, but also literary and cultural studies scholarship by, about, and for Black women. We will interrogate why these women’s voices have been muted and discuss the ways in which their words have been recovered through the hard work of other Black women writers like Alice Walker, who is responsible for the re-emergence of Zora Neale Hurston and her 1937 novel Their Eyes Were Watching God. Through weekly reading assignments, lectures, and discussions, this class will culminate in final papers and presentations about one of our course texts."}]},{"id":"GWS 288","title":"Global Islam and Feminisms","creditHours":"3 hours.","sections":[{"crn":"76796","code":"MK","type":"Lecture-Discussion","partOfTerm":"1","meetings":[{"type":"Lecture-Discussion","days":["T","R"],"start":570,"end":650,"location":"104 English Building","instructors":["Khan, M"]}],"restrictions":[],"note":""}]},{"id":"GWS 305","title":"Theories of Race, Gender, and Sexuality","creditHours":"3 hours.","sections":[{"crn":"69049","code":"A","type":"Lecture-Discussio